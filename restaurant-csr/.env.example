NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:3000
# Supabase Session pooler PostgreSQL URI; use the existing restaurant schema.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional CLI migration connection; no migrations are needed for Block 6.
# MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres

# Server-only photo storage. Never prefix these secrets with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-server-secret-key
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=dish-photos
