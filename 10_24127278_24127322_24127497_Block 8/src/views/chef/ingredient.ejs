<%- include('../partials/header') %>
<a class="breadcrumb" href="/kitchen/ingredients">← THE PANTRY</a><div class="room-heading compact-heading"><div><p class="eyebrow">食材 · Ingredient ledger</p><h1><%= ingredient.name %></h1></div><a class="button" href="/kitchen/stock/new?ingredientId=<%= ingredient.id %>">Record stock change ↗</a></div>
<section class="ingredient-ledger"><div class="ledger-summary"><span class="eyebrow">On the shelf</span><h2><%= ingredient.quantityOnHand.toString() %> <small><%= ingredient.baseUnit %></small></h2><p><%= ingredient.description || 'A kitchen staple, counted with care.' %></p><span class="status-tag <%= Number(ingredient.quantityOnHand)<=Number(ingredient.lowStockThreshold)?'warning':'' %>"><%= !ingredient.isActive?'Inactive':Number(ingredient.quantityOnHand)<=Number(ingredient.lowStockThreshold)?'Low stock':'In stock' %></span><p>Reorder at <%= ingredient.lowStockThreshold.toString() %> <%= ingredient.baseUnit %>.</p><% if(user.role==='admin'){ %><a href="/kitchen/ingredients/<%= ingredient.id %>/edit">Edit ingredient label ↗</a><% } %><h3>Used in recipes</h3><% if(!ingredient.recipeItems.length){ %><p>No saved recipes use this ingredient yet.</p><% } %><ul><% ingredient.recipeItems.forEach(item=>{ %><li><a href="/kitchen/dishes/<%= item.recipe.dish.id %>/recipe"><%= item.recipe.dish.name %></a> · <%= item.quantity.toString() %> <%= ingredient.baseUnit %> / serving</li><% }) %></ul></div><div class="ledger-history"><p class="eyebrow">Latest 30 movements</p><h2>The pantry journal.</h2><% if(!ingredient.movements.length){ %><p>No stock changes recorded yet.</p><% } %><% ingredient.movements.forEach(m=>{ %><article class="ledger-entry"><header><strong><%= m.operation.type %></strong><span><%= Number(m.quantityDelta)>0?'+':'' %><%= m.quantityDelta.toString() %> <%= ingredient.baseUnit %></span></header><p><%= m.operation.reason %></p><small><%= m.operation.actor.displayName %> · <time datetime="<%= m.createdAt.toISOString() %>"><%= m.createdAt.toLocaleString('en-GB',{timeZone:'Asia/Ho_Chi_Minh'}) %> (ICT)</time></small><p class="muted-copy"><%= m.quantityBefore.toString() %> → <%= m.quantityAfter.toString() %> <%= ingredient.baseUnit %></p></article><% }) %></div></section><%- include('../partials/footer') %>