<%- include('../partials/header') %><div class="room-heading compact-heading"><div><a class="breadcrumb" href="/kitchen" data-journey="right">← THE KITCHEN</a><p class="eyebrow">記録 · The pantry journal</p><h1>Every change,<br><em>remembered.</em></h1></div><a class="button" href="/kitchen/stock/new">＋ Record stock change</a></div><p class="muted-copy">The latest 100 operations. Corrections create new entries; history stays intact.</p><% if(!operations.length){ %><div class="empty-state"><h2>A clean page.</h2><p>Stock movements will appear here as the kitchen gets to work.</p></div><% } %><% operations.forEach(op=>{ %><article class="journal-entry"><div class="journal-top"><h2><%= op.type %></h2><time datetime="<%= op.createdAt.toISOString() %>"><%= op.createdAt.toLocaleString('en-GB',{timeZone:'Asia/Ho_Chi_Minh'}) %></time></div><p><%= op.reason %> · <%= op.actor.displayName %><%= op.servings?` · ${op.servings} servings · recipe v${op.recipeVersion}`:'' %></p><table><thead><tr><th>Ingredient</th><th>Change</th><th>Before</th><th>After</th></tr></thead><tbody><% op.movements.forEach(m=>{ %><tr><td><%= m.ingredient.name %></td><td><%= m.quantityDelta.toString() %> <%= m.ingredient.baseUnit %></td><td><%= m.quantityBefore.toString() %></td><td><%= m.quantityAfter.toString() %></td></tr><% }) %></tbody></table></article><% }) %><%- include('../partials/footer') %>