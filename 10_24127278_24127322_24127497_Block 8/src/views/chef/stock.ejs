<%- include('../partials/header') %><a class="breadcrumb" href="/kitchen/ingredients" data-journey="right">← THE INGREDIENT PANTRY</a><div class="room-heading compact-heading"><div><p class="eyebrow">食材 · Every ingredient counts</p><h1>Record stock change.</h1></div></div><% const current=typeof input!=='undefined'?input:{}; if(error){ %><p class="error" role="alert"><%= error %></p><% } %><div class="stock-panels"><% [['usage','usage','Ingredients used in preparation.'],['waste','waste','Record spoilage, spills, or discarded ingredients.'],...(user.role==='admin'?[['receipt','receipts','Bring newly received ingredients into the pantry.'],['correction','corrections','Enter a signed difference (+/-), rather than a target balance.']]:[])].forEach(([type,route,description])=>{ %><section class="stock-panel"><p class="eyebrow">Pantry journal</p><h2><%= type %></h2><p><%= description %></p><form method="post" action="/kitchen/stock/<%= route %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="requestKey" value="<%= requestKey %>"><label>Ingredient<select name="ingredientId" required><% ingredients.filter(i=>i.isActive).forEach(i=>{ %><option value="<%= i.id %>" <%= (!current.type || current.type===type) && current.ingredientId===i.id?'selected':'' %>><%= i.name %> — <%= i.quantityOnHand.toString() %> <%= i.baseUnit %></option><% }) %></select></label><label>Quantity · base unit<input name="quantity" value="<%= current.type===type?current.quantity || '':'' %>" type="<%= type==='correction'?'text':'number' %>" inputmode="decimal" <%= type==='correction'?'':'step=0.001 min=0.001' %> required></label><label>Reason<input name="reason" value="<%= current.type===type?current.reason || '':'' %>" maxlength="2000" required></label><button>Record <%= type %> ↗</button></form></section><% }) %></div><%- include('../partials/footer') %>