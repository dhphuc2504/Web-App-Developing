<% if(dish.imagePath==='/images/japan/food-atlas.png'){ %><span class="food-image food-atlas food-<%= foodIndex(dish) %>" role="img" aria-label="<%= dish.imageAlt || dish.name %>"></span><% }else if(dish.imagePath){ %><img class="food-image" src="<%= dish.imagePath %>" alt="<%= dish.imageAlt || dish.name %>" loading="lazy"><% }else{ %><span class="food-image food-placeholder" role="img" aria-label="Photograph not yet added for <%= dish.name %>"><span lang="ja" aria-hidden="true">食</span><small>Photograph coming soon</small></span><% } %>