<section class="pantry-workspace" data-pantry><div class="pantry-toolbar"><label>Find an ingredient<input type="search" data-pantry-search placeholder="Search the shelf…"></label><label class="check-label"><input type="checkbox" data-pantry-low> Low stock only</label><button class="secondary compact" type="button" data-pantry-view aria-pressed="false">List view</button><a class="button secondary" href="/kitchen/stock/new">Record stock change ↗</a></div><div class="pantry-shelf"><% rows.forEach(row=>{const low=Number(row.quantityOnHand)<=Number(row.lowStockThreshold); %><article class="pantry-jar <%= low?'jar-low':'' %>" data-pantry-item data-name="<%= row.name.toLowerCase() %>" data-low="<%= low %>"><a class="jar-label" href="/kitchen/ingredients/<%= row.id %>" aria-label="Open <%= row.name %> ingredient ledger — <%= row.quantityOnHand.toString() %> <%= row.baseUnit %>, <%= !row.isActive?'inactive':low?'low stock':'in stock' %>"><span class="jar-cap" aria-hidden="true"></span><span class="jar-body"><span class="jar-paper"><span class="eyebrow">SANTAISHI-TEI / PANTRY</span><h2><%= row.name %></h2><strong><%= row.quantityOnHand.toString() %> <small><%= row.baseUnit %></small></strong><span class="status-tag <%= low?'warning':'' %>"><%= !row.isActive?'Inactive':low?'Low stock':'In stock' %></span><span class="jar-hint">Open ledger ↗</span></span></span></a><div class="jar-actions"><span>Reorder: <%= row.lowStockThreshold.toString() %> <%= row.baseUnit %></span><% if(user.role==='admin'){ %><a href="<%= base %>/<%= row.id %>/edit">Edit label</a><form class="inline" method="post" action="<%= base %>/<%= row.id %>" data-confirm="Archive <%= row.name %>? Its history will be preserved."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="_method" value="DELETE"><button class="danger-link">Archive</button></form><% } %></div></article><% }) %></div><p class="pantry-empty" data-pantry-empty <%= rows.length?'hidden':'' %>>No ingredients match this shelf.</p><p class="list-caption">Showing up to 100 ingredients. Recipe edits do not change stock; record usage or waste in the journal.</p></section>