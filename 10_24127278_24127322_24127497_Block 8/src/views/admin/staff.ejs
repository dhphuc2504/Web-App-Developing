<%- include('../partials/header') %><div class="room-heading compact-heading"><div><a class="breadcrumb" href="/admin" data-journey="forward">← THE OFFICE</a><p class="eyebrow">料理人 · The team</p><h1>Chef accounts</h1></div><a class="quiet-link" href="#new-chef">Invite a new pair of hands ↓</a></div><%- include('../partials/staff-roster',{rows}) %><section class="form-panel new-chef-panel" id="new-chef"><div><p class="eyebrow">Grow the kitchen</p><h2>Add a chef</h2><p>Create a staff account for dish, recipe, and kitchen work. Chef accounts cannot enter the administrator’s room.</p></div><form method="post" action="/admin/staff"><% if(error){ %><p class="error" role="alert"><%= error %></p><% } %><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Display name<input name="displayName" value="<%= input.displayName || '' %>" maxlength="100" placeholder="Chef's name" required></label><label>Email address<input name="email" value="<%= input.email || '' %>" type="email" maxlength="254" autocomplete="off" placeholder="chef@example.com" required></label><label>Initial password<input name="password" type="password" minlength="12" maxlength="256" autocomplete="new-password" required><small>At least 12 characters. Share it privately with the chef.</small></label><button>Create chef account ↗</button></form></section><%- include('../partials/footer') %>