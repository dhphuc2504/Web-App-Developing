<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Classroom · Student List</title>
  <script src="/assets/theme.js"></script>
  <link rel="stylesheet" href="/assets/styles.css">
  <script src="/assets/classroom.js" defer></script>
</head>
<body>
  <%- include('partials/header', { page: 'classroom' }) %>
  <main class="shell">
    <div class="page-heading"><p class="eyebrow">CLASSROOM POSITIONS</p><h1>Give everyone their place.</h1><p>Drag a student to a seat. Drop onto another student to swap their positions.</p></div>
    <% if (message) { %><div class="notice <%= messageType %>" role="status"><%= message %></div><% } %>
    <section class="card classroom-card" aria-labelledby="classroom-title">
      <div class="card-heading"><div><h2 id="classroom-title">Classroom</h2><p>Hover or focus a student to see their details.</p></div><span class="count"><%= students.length %> students</span></div>
      <div class="board">TEACHER’S BOARD <span>Front of classroom</span></div>
      <p class="room-status" id="room-status" role="status">Click a student, then a destination seat, or use the move form below.</p>
      <% if (students.length === 0) { %><p class="room-status">No students yet. <a href="/Student">Add your first student</a> to start arranging seats.</p><% } %>
      <div class="room-scroll"><div class="seat-grid" aria-label="Classroom seats">
        <% seats.forEach(seat => { %>
          <div class="seat" data-row="<%= seat.row %>" data-column="<%= seat.column %>">
            <span class="seat-label"><%= seat.label %></span>
            <% if (seat.student) { %>
              <button type="button" class="student-card" data-student-id="<%= seat.student.id %>" aria-pressed="false" aria-describedby="info-<%= seat.row %>-<%= seat.column %>">
                <span class="avatar" aria-hidden="true"><%= seat.student.initial %></span>
                <span class="card-name"><%= seat.student.name %></span><span class="card-id"><%= seat.student.id %> <span aria-hidden="true">⠿</span></span>
              </button>
              <div class="student-popup" role="tooltip" id="info-<%= seat.row %>-<%= seat.column %>"><strong><%= seat.student.name %></strong><span>ID: <%= seat.student.id %></span><span><%= seat.student.email %></span><span><%= seat.label %></span></div>
            <% } else { %>
              <button type="button" class="empty-seat" aria-label="Move selected student to <%= seat.label %>"><span aria-hidden="true">＋</span><span>Empty seat</span></button>
            <% } %>
          </div>
        <% }); %>
      </div></div>
      <div class="card-footer">Positions are saved after each move. Extra rows appear as the classroom fills.</div>
    </section>
    <% if (students.length > 0) { %>
      <section class="card move-panel" aria-labelledby="move-title">
        <div class="card-heading"><div><h2 id="move-title">Move a student</h2><p>Use these controls with a keyboard or when dragging is inconvenient.</p></div></div>
        <form id="move-form" action="/Classroom/Move" method="post" class="move-form">
          <input type="hidden" name="formToken" value="<%= token %>"><input type="hidden" name="revision" value="<%= revision %>">
          <div><label for="move-student">Student</label><select id="move-student" name="id" required><% students.forEach(student => { %><option value="<%= student.id %>"><%= student.id %> · <%= student.name %></option><% }); %></select></div>
          <div><label for="move-row">Row</label><input id="move-row" name="row" type="number" min="1" max="50" value="1" required></div>
          <div><label for="move-column">Seat</label><select id="move-column" name="column"><% for (let column = 1; column <= 6; column++) { %><option value="<%= column %>"><%= column %></option><% } %></select></div>
          <button type="submit">Save position →</button>
        </form>
      </section>
    <% } %>
    <footer class="page-footer">Student List <span>One classroom. A place for everyone.</span></footer>
  </main>
</body>
</html>
