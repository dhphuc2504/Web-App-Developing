<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student List · Class directory</title>
  <script src="/assets/theme.js"></script>
  <link rel="stylesheet" href="/assets/styles.css">
</head>
<body>
  <%- include('partials/header', { page: 'students' }) %>
  <main class="shell">
    <div class="page-heading"><p class="eyebrow">CLASS DIRECTORY</p><h1>A place for every student.</h1><p>Keep your class list together. Add a student and see the updated directory.</p></div>
    <% if (message) { %>
      <div class="notice <%= messageType %>" role="status"><%= message %></div>
    <% } %>
    <div class="layout">
      <section class="card directory" aria-labelledby="directory-title">
        <div class="card-heading"><div><h2 id="directory-title">Students</h2><p>Your class, at a glance.</p></div><span class="count"><%= countLabel %></span></div>
        <% if (students.length === 0) { %>
          <div class="empty-state"><span class="empty-icon" aria-hidden="true">＋</span><h3>Your class list starts here</h3><p>Add your first student using the form.<br>Their details will appear here.</p><a href="#student-id">Add your first student <span aria-hidden="true">→</span></a></div>
        <% } else { %>
          <div class="table-wrap"><table><caption class="sr-only">Registered students and their contact details</caption><thead><tr><th scope="col">Student ID</th><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Position</th></tr></thead><tbody>
            <% students.forEach(student => { %>
              <tr><td><span class="student-id"><%= student.id %></span></td><td><div class="student-name"><span class="avatar" aria-hidden="true"><%= student.initial %></span><span><%= student.name %></span></div></td><td><%= student.email %></td><td class="position-cell">Row <%= student.position.row %>, seat <%= student.position.column %></td></tr>
            <% }); %>
          </tbody></table></div>
        <% } %>
        <div class="card-footer">A fresh class list is rendered after each successful addition.</div>
      </section>
      <section class="card form-card" aria-labelledby="add-title">
        <div class="card-heading"><div><h2 id="add-title">Add a student</h2><p>A few details, a new classmate.</p></div></div>
        <form action="/AddStudent" method="post">
          <input type="hidden" name="formToken" value="<%= formToken %>">
          <% if (hasErrors) { %><div class="form-alert" role="alert">Please check the highlighted fields. Your details have been kept.</div><% } %>
          <div class="field"><label for="student-id">Student ID <span>required</span></label><input id="student-id" name="id" value="<%= values.id %>" placeholder="e.g. ST001" required maxlength="5" pattern="[Ss][Tt](?!000)[0-9]{3}" aria-invalid="<%= errors.id ? 'true' : 'false' %>" aria-describedby="id-hint<%= errors.id ? ' id-error' : '' %>"><p id="id-hint" class="hint">Use ST001–ST999: ST followed by three digits.</p><% if (errors.id) { %><p id="id-error" class="field-error"><%= errors.id %></p><% } %></div>
          <div class="field"><label for="student-name">Full name <span>required</span></label><input id="student-name" name="name" value="<%= values.name %>" placeholder="e.g. Nguyen Minh Anh" required minlength="2" maxlength="100" autocomplete="name" aria-invalid="<%= errors.name ? 'true' : 'false' %>" aria-describedby="name-hint<%= errors.name ? ' name-error' : '' %>"><p id="name-hint" class="hint">Between 2 and 100 characters.</p><% if (errors.name) { %><p id="name-error" class="field-error"><%= errors.name %></p><% } %></div>
          <div class="field"><label for="student-email">Email address <span>required</span></label><input id="student-email" name="email" type="email" value="<%= values.email %>" placeholder="e.g. anh@example.com" required maxlength="254" autocomplete="email" aria-invalid="<%= errors.email ? 'true' : 'false' %>" aria-describedby="email-hint<%= errors.email ? ' email-error' : '' %>"><p id="email-hint" class="hint">Use a unique email address for each student.</p><% if (errors.email) { %><p id="email-error" class="field-error"><%= errors.email %></p><% } %></div>
          <button type="submit">Add student <span aria-hidden="true">＋</span></button>
          <p class="form-note">All fields are required. Your student list is saved automatically.</p>
        </form>
      </section>
    </div>
    <footer class="page-footer">Student List <span>Built for learning. One student at a time.</span></footer>
  </main>
</body>
</html>
