<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#191b19"><meta name="description" content="Step inside Santaishi-tei, a Japanese restaurant experience."><title><%= title %> · Santaishi-tei</title><link rel="stylesheet" href="/css/app.css"><link rel="stylesheet" href="/css/experience-v2.css"><script src="/js/journey-start.js"></script><script src="/js/experience.js" defer></script><% if(pageClass==='page-dining'){ %><link rel="preload" as="image" href="/images/japan/dining-table.jpg"><% }else if(pageClass==='page-kitchen'){ %><link rel="preload" as="image" href="/images/japan/kitchen.jpg"><% } %></head>
<body class="<%= pageClass %>">
<div class="journey-overlay" aria-hidden="true"><div class="journey-panel journey-left"></div><div class="journey-panel journey-right"></div></div>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header"><a class="brand" href="/" data-journey="forward"><span class="brand-seal" lang="ja" aria-hidden="true">三</span><span>SANTAISHI-TEI<small>JAPANESE KITCHEN</small></span></a>
<nav aria-label="Main navigation"><a href="/directory" data-journey="forward" <%- path==='/directory'?'aria-current="page"':'' %>>The house</a><a href="/menu" data-journey="left" <%- path.startsWith('/menu')?'aria-current="page"':'' %>>Dining room</a><% if(user){ %><a href="/kitchen" data-journey="right" <%- path.startsWith('/kitchen')?'aria-current="page"':'' %>>Kitchen</a><% if(user.role==='admin'){ %><a href="/admin" data-journey="forward" <%- path.startsWith('/admin')?'aria-current="page"':'' %>>Office</a><% } %><span class="staff-name"><%= user.displayName %><small><%= user.role %></small></span><form class="inline" method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="text-button">Sign out</button></form><% }else{ %><a class="staff-entry" href="/login" data-journey="right">Staff entrance <span aria-hidden="true">↗</span></a><% } %></nav></header>
<main id="main" class="<%= pageClass==='page-entrance'||pageClass==='page-directory'?'scene-main':'content-main' %>"><% if(flash){ %><div class="notice" role="status"><span aria-hidden="true">✓</span> <%= flash %></div><% } %>
