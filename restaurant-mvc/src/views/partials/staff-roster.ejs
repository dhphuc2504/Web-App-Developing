<section class="staff-roster"><div class="section-heading"><h2>The people behind the plates.</h2><span><%= rows.filter(r=>r.role==='chef' && r.isActive).length %> active chefs</span></div><div class="staff-grid"><% rows.forEach(row=>{ %><article class="staff-card <%= row.isActive?'':'staff-inactive' %>"><div class="staff-card-top"><span class="staff-avatar"><%= row.displayName.trim().split(/\s+/).map(n=>n[0]).slice(0,2).join('').toUpperCase() %></span><span class="status-tag <%= row.isActive?'':'muted' %>"><%= row.isActive?'Active':'Access removed' %></span></div><h3><%= row.displayName %></h3><p class="staff-role"><%= row.role==='admin'?'Administrator':'Chef' %></p><p class="staff-email"><%= row.email %></p><% if(row.role==='chef'){ %><details class="profile-editor"><summary>Edit profile</summary><form method="post" action="/admin/staff/<%= row.id %>/update"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Display name<input name="displayName" value="<%= row.displayName %>" maxlength="100" required></label><label class="check-label"><input type="checkbox" name="isActive" <%= row.isActive?'checked':'' %>> Active access</label><button class="compact">Save profile</button></form></details><% if(row.isActive){ %><form method="post" action="/admin/staff/<%= row.id %>" data-confirm="Remove kitchen access for <%= row.displayName %>? Their historical stock and recipe records will be preserved."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="_method" value="DELETE"><button class="danger-link">Remove chef access</button></form><% } %><% }else{ %><span class="admin-note">Restaurant management</span><% } %></article><% }) %></div></section>