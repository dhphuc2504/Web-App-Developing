<section data-board-workspace><div class="board-toolbar"><label class="board-search">Find a dish<input type="search" placeholder="Search the board…" data-board-search aria-label="Search dishes on the kitchen board"></label><a class="button" href="/kitchen/dishes/new" data-paper-link>＋ Add a dish</a></div><div class="kitchen-board" data-board><% [['published','On the menu',dishes.filter(d=>d.isPublished && d.isAvailable)],['draft','In preparation',dishes.filter(d=>!d.isPublished)],['unavailable','Off the menu',dishes.filter(d=>d.isPublished && !d.isAvailable)]].forEach(([state,label,items])=>{ %><section class="board-column"><div class="board-column-heading"><span class="board-dot <%= state %>"></span><h2><%= label %></h2><span class="column-count"><%= items.length %></span></div><% if(!items.length){ %><p class="board-empty">No dishes here yet.</p><% } %><div class="ticket-stack"><% items.forEach((dish,i)=>{ %><article class="dish-ticket" data-ticket-id="<%= dish.id %>" data-search-text="<%= dish.name.toLowerCase() %> <%= dish.category.name.toLowerCase() %>"><div class="ticket-top"><span>三太子亭 / KITCHEN</span><span>#<%= String(i+1).padStart(2,'0') %></span></div><span class="ticket-category"><%= dish.category.name %></span><h3><%= dish.name %></h3><div class="ticket-food"><%- include('./food',{dish}) %></div><p><%= dish.description || 'No description yet.' %></p><div class="ticket-price"><strong><%= money(dish.priceMinor) %></strong><span class="status-tag <%= state %>"><%= state==='draft'?'Draft':state==='unavailable'?'Unavailable':'Published' %></span></div><div class="ticket-actions"><a href="/kitchen/dishes/<%= dish.id %>/recipe" data-paper-link>Recipe & ingredients ↗</a><a href="/kitchen/dishes/<%= dish.id %>/edit" data-paper-link>Edit dish</a><form method="post" action="/kitchen/dishes/<%= dish.id %>" data-confirm="Archive <%= dish.name %>? It will leave the menu, while its recipe and history are preserved."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="_method" value="DELETE"><button class="danger-link">Archive</button></form></div></article><% }) %></div></section><% }) %></div><p class="board-no-results" data-board-empty hidden>No dishes match your search.</p></section>