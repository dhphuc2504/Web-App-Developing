<%- include('../partials/header') %><div class="room-heading compact-heading"><div><a class="breadcrumb" href="<%= kind==='category'?'/admin':'/kitchen' %>">← <%= kind==='category'?'THE OFFICE':'THE KITCHEN' %></a><p class="eyebrow"><%= kind==='ingredient'?'食材 · The pantry':kind==='dish'?'厨房 · Dish management':'献立 · Menu organization' %></p><h1><%= title %></h1></div><% if(kind!=='dish' && user.role==='admin'){ %><a class="button" href="<%= base %>/new">＋ Add <%= kind %></a><% } %></div><% if(kind==='dish'){ %><%- include('../partials/ticket-board',{dishes:rows}) %><% }else if(kind==='ingredient'){ %><%- include('../partials/pantry',{rows,base}) %><% }else{ %><% if(kind==='ingredient'){ %><div class="pantry-toolbar"><p>Exact quantities. A clear view of the kitchen.</p><a class="button secondary" href="/kitchen/stock/new">Record stock change ↗</a></div><% } %><div class="data-panel"><table><thead><tr><th><%= kind==='ingredient'?'Ingredient':'Category' %></th><th><%= kind==='ingredient'?'Stock on hand':'Slug' %></th><th><%= kind==='ingredient'?'Reorder at':'Order' %></th><th>Status</th><th>Manage</th></tr></thead><tbody><% rows.forEach(row=>{ %><tr><td><strong><%= row.name %></strong><small><%= row.description || '' %></small></td><td><%= kind==='ingredient'?row.quantityOnHand.toString():row.slug %><%= kind==='ingredient'?' '+row.baseUnit:'' %></td><td><%= kind==='ingredient'?row.lowStockThreshold.toString():row.displayOrder %></td><td><span class="status-tag <%= kind==='ingredient' && Number(row.quantityOnHand)<=Number(row.lowStockThreshold)?'warning':'' %>"><%= !row.isActive?'Inactive':kind==='ingredient' && Number(row.quantityOnHand)<=Number(row.lowStockThreshold)?'Low stock':'Active' %></span></td><td><% if(user.role==='admin'){ %><a href="<%= base %>/<%= row.id %>/edit">Edit</a><form class="inline" method="post" action="<%= base %>/<%= row.id %>" data-confirm="Archive <%= row.name %>? Existing references and stock history will be preserved."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="_method" value="DELETE"><button class="danger-link">Archive</button></form><% }else{ %><span class="muted-copy">View only</span><% } %></td></tr><% }) %></tbody></table><% if(!rows.length){ %><div class="empty-state"><h2>A fresh start.</h2><p>Add your first <%= kind %> to begin.</p></div><% } %></div><p class="list-caption">Showing up to 100 records. Archived records retain their history.</p><% } %><%- include('../partials/footer') %>