<%- include('../partials/header') %><a class="breadcrumb" href="<%= action.startsWith('/kitchen/dishes')?'/kitchen':action.startsWith('/kitchen')?'/kitchen/ingredients':'/admin/categories' %>">← BACK TO MANAGEMENT</a><div class="room-heading compact-heading"><div><p class="eyebrow">A detail worth getting right</p><h1><%= title %></h1></div></div><section class="form-panel editor-panel" <%- action.startsWith('/kitchen/dishes')?'data-paper-sheet':'' %>><div class="form-intro"><span class="large-kanji" lang="ja">丁寧</span><h2><%= title %></h2><p>Keep the menu clear, the ingredients accurate, and every detail considered.</p><% if(action.startsWith('/kitchen/dishes')){ %><p class="muted-copy">A new dish starts as a draft. Publish it when it is ready for the dining room.</p><% } %></div><form method="post" action="<%= action %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(error){ %><p class="error" role="alert"><%= error %></p><% } %><% fields.forEach(([name,label,type])=>{const value=values[name]; %><label class="<%= type==='checkbox'?'check-label':'' %>"><% if(type==='checkbox'){ %><input type="checkbox" name="<%= name %>" <%= value?'checked':'' %>><%= label %><% }else{ %><%= label %><% if(type==='textarea'){ %><textarea name="<%= name %>" rows="4"><%= value || '' %></textarea><% }else if(type==='select'){ %><select name="<%= name %>" required><% options.forEach(([id,text])=>{ %><option value="<%= id %>" <%= value===id?'selected':'' %>><%= text %></option><% }) %></select><% }else{ %><input type="<%= type %>" name="<%= name %>" value="<%= value==null?'':value.toString() %>" <%= type==='number'?'min=0 step=any':'' %>><% } %><% } %></label><% }) %><div class="button-row"><button>Save changes ↗</button><a class="quiet-link" href="<%= action.startsWith('/kitchen/dishes')?'/kitchen':action.startsWith('/kitchen')?'/kitchen/ingredients':'/admin/categories' %>" data-paper-cancel>Return to management</a></div></form></section><%- include('../partials/footer') %>