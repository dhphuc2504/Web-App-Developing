<%- include('../partials/header') %>
<div class="room-heading dining-heading"><div><a class="breadcrumb" href="/directory" data-journey="right">THE HOUSE / 01</a><p class="eyebrow">食堂 · The dining room</p><h1>Something <em>delicious.</em></h1></div><p class="heading-note">A seat at the table. A page to discover.<br>Choose a dish to take a closer look.</p></div>
<div data-menu-shell data-page="<%= page %>">
<div class="menu-controls"><nav class="category-tabs" aria-label="Menu categories"><a data-book-link href="<%= menuUrl({category:'',page:'1'}) %>" <%- !category?'aria-current="page"':'' %>>All dishes</a><% categories.forEach(c=>{ %><a data-book-link href="<%= menuUrl({category:c.slug,page:'1'}) %>" <%- category===c.slug?'aria-current="page"':'' %>><%= c.name %></a><% }) %></nav><form class="sort-form" data-book-form method="get" action="/menu"><% if(category){ %><input type="hidden" name="category" value="<%= category %>"><% } %><label class="sr-only" for="menu-search">Find a dish</label><input id="menu-search" name="q" value="<%= q %>" placeholder="Find a dish…"><label for="sort">Sort by</label><select id="sort" name="sort" data-auto-submit><% [['recommended','Chef’s selection'],['name','Name A–Z'],['price_asc','Price: low to high'],['price_desc','Price: high to low']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= sort===value?'selected':'' %>><%= label %></option><% }) %></select><button class="secondary compact">Apply</button></form></div>
<section class="menu-book" aria-label="Menu page <%= page %>"><div class="book-spread"><% [0,1].forEach(side=>{ %><div class="book-page page-<%= side?'right':'left' %>"><header class="book-page-heading"><span lang="ja">三太子亭</span><span><%= side?'THE SELECTION':'SANTAISHI-TEI / MENU' %></span></header>
<% dishes.slice(side*2,side*2+2).forEach((dish,i)=>{ %><article class="menu-entry"><button class="photo-trigger" type="button" data-dish-dialog="dish-<%= dish.id %>" aria-haspopup="dialog" aria-label="View <%= dish.name %> details"><%- include('../partials/food',{dish}) %></button><div class="menu-entry-copy"><span class="eyebrow"><%= dish.category.name %></span><h2><a href="/menu/<%= dish.slug %>" data-dish-open="dish-<%= dish.id %>"><%= dish.name %></a></h2><p><%= dish.description || 'Made with care in our kitchen.' %></p><strong><%= money(dish.priceMinor) %></strong><% if(!dish.isAvailable){ %><small class="availability-note">Currently unavailable</small><% } %></div></article><% }) %>
<% if(!dishes.length && !side){ %><div class="book-empty"><span lang="ja">食</span><h2>A quiet page, for now.</h2><p><%= q || category?'No dishes match your selection. Try another category or clear your search.':'Our kitchen is preparing the menu. Come back soon.' %></p><a data-book-link href="/menu">View all dishes ↗</a></div><% }else if(dishes.length<=2 && side){ %><div class="book-empty quiet-page"><span lang="ja">ごゆっくり</span><p>Good food.<br>Quiet moments.</p></div><% } %>
<footer class="book-page-footer"><span><%= side?'Made with care.':'A taste of Japan.' %></span><span><%= String((page-1)*2+side+1).padStart(2,'0') %></span></footer></div><% }) %></div><span class="book-ribbon" aria-hidden="true"></span><div class="book-turn-sheet" aria-hidden="true" inert></div></section>
<nav class="table-pagination book-pagination" aria-label="Menu pages"><% if(page>1){ %><a class="table-arrow" data-book-link data-flip="back" href="<%= menuUrl({page:String(page-1)}) %>">← Previous page</a><% }else{ %><span class="table-arrow disabled">← Previous page</span><% } %><div><span class="page-count">PAGE <%= String(page).padStart(2,'0') %> / <%= String(pageCount).padStart(2,'0') %></span><% for(let n=Math.max(1,page-2);n<=Math.min(pageCount,page+2);n++){ %><a data-book-link data-flip="<%= n<page?'back':'next' %>" href="<%= menuUrl({page:String(n)}) %>" <%- n===page?'aria-current="page"':'' %> aria-label="Page <%= n %>"><%= String(n).padStart(2,'0') %></a><% } %></div><% if(page<pageCount){ %><a class="table-arrow" data-book-link data-flip="next" href="<%= menuUrl({page:String(page+1)}) %>">Next page →</a><% }else{ %><span class="table-arrow disabled">Next page →</span><% } %></nav>
<% dishes.forEach(dish=>{ %><dialog class="dish-dialog" id="dish-<%= dish.id %>" aria-labelledby="dish-title-<%= dish.id %>"><button class="dialog-close" type="button" data-dialog-close aria-label="Close dish details">×</button><%- include('../partials/food',{dish}) %><p class="eyebrow"><%= dish.category.name %></p><h2 id="dish-title-<%= dish.id %>"><%= dish.name %></h2><p><%= dish.description || 'Made with care in our kitchen.' %></p><p class="dish-price"><%= money(dish.priceMinor) %></p><span class="status-tag <%= dish.isAvailable?'':'muted' %>"><%= dish.isAvailable?'Available in the dining room':'Currently unavailable' %></span><a class="quiet-link" href="/menu/<%= dish.slug %>">Full dish page ↗</a></dialog><% }) %>
<p class="menu-status sr-only" data-menu-status role="status"></p></div>
<%- include('../partials/footer') %>