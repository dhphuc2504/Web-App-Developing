{
  "name": "restaurant-mvc",
  "version": "1.0.0",
  "description": "JavaScript SSR restaurant backend with Express MVC, Prisma, Supabase and PRG",
  "main": "src/app.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "db:generate": "node scripts/prisma.js generate",
    "db:validate": "node scripts/prisma.js validate",
    "db:deploy": "node scripts/prisma.js migrate deploy",
    "db:seed": "node scripts/seed.js",
    "admin:create": "node scripts/create-admin.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.7",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "method-override": "^3.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.0"
  },
  "engines": {
    "node": ">=24"
  }
}
